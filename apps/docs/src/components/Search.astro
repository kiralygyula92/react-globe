---
/**
 * Full-text search over the static Pagefind index built after `astro build`. The header shows a
 * compact trigger; it (or `/`) opens a modal dialog with the field and results. Arrow keys move
 * through results; Escape or the close button dismisses. There is no index under `astro dev`,
 * which the dialog says instead of failing silently.
 */
---

<div class="search">
  <button type="button" class="search-trigger" data-search-open aria-haspopup="dialog" aria-keyshortcuts="/">
    <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
      <path fill="currentColor" d="M8.5 3a5.5 5.5 0 0 1 4.38 8.82l3.65 3.65a.75.75 0 1 1-1.06 1.06l-3.65-3.65A5.5 5.5 0 1 1 8.5 3Zm0 1.5a4 4 0 1 0 0 8 4 4 0 0 0 0-8Z"></path>
    </svg>
    <span class="search-trigger-label">Search</span>
    <kbd aria-hidden="true">/</kbd>
  </button>

  <dialog class="search-dialog" id="docs-search-dialog" aria-labelledby="docs-search-title">
    <div class="search-dialog-panel">
      <div class="search-dialog-header">
        <p class="search-dialog-title" id="docs-search-title">Search</p>
        <button type="button" class="icon-button search-close" data-search-close aria-label="Close search">
          <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
            <path fill="currentColor" d="M5.28 4.22a.75.75 0 0 0-1.06 1.06L8.94 10l-4.72 4.72a.75.75 0 1 0 1.06 1.06L10 11.06l4.72 4.72a.75.75 0 1 0 1.06-1.06L11.06 10l4.72-4.72a.75.75 0 0 0-1.06-1.06L10 8.94 5.28 4.22Z"></path>
          </svg>
        </button>
      </div>
      <div class="search-field" role="search">
        <label class="sr-only" for="docs-search">Search the documentation</label>
        <svg class="search-icon" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
          <path fill="currentColor" d="M8.5 3a5.5 5.5 0 0 1 4.38 8.82l3.65 3.65a.75.75 0 1 1-1.06 1.06l-3.65-3.65A5.5 5.5 0 1 1 8.5 3Zm0 1.5a4 4 0 1 0 0 8 4 4 0 0 0 0-8Z"></path>
        </svg>
        <input id="docs-search" type="search" placeholder="Search" autocomplete="off" spellcheck="false" />
      </div>
      <div id="docs-search-results" class="search-results" role="region" aria-label="Search results" aria-live="polite" hidden></div>
    </div>
  </dialog>
</div>

<script>
  type PagefindResult = { data: () => Promise<{ url: string; meta: { title?: string }; excerpt: string }> };
  type Pagefind = { search: (term: string) => Promise<{ results: PagefindResult[] }> };

  const dialog = document.querySelector<HTMLDialogElement>('#docs-search-dialog');
  const input = document.querySelector<HTMLInputElement>('#docs-search');
  const panel = document.querySelector<HTMLDivElement>('#docs-search-results');
  const MAX_RESULTS = 8;
  let pagefind: Promise<Pagefind | null> | null = null;
  let timer = 0;
  let query = 0;

  const load = (): Promise<Pagefind | null> => {
    const path = '/pagefind/pagefind.js';
    pagefind ??= import(/* @vite-ignore */ path).then(
      (module: Pagefind) => module,
      () => null,
    );
    return pagefind;
  };

  const show = (visible: boolean) => {
    if (panel) panel.hidden = !visible;
  };

  const message = (text: string) => {
    if (!panel) return;
    const p = document.createElement('p');
    p.className = 'search-message';
    p.textContent = text;
    panel.replaceChildren(p);
    show(true);
  };

  async function run(term: string) {
    const id = ++query;
    if (!term.trim()) {
      show(false);
      return;
    }
    const engine = await load();
    if (id !== query) return;
    if (!engine) {
      message('Search is available in the built site: run pnpm docs:build, then pnpm docs:serve.');
      return;
    }
    const { results } = await engine.search(term);
    const items = await Promise.all(results.slice(0, MAX_RESULTS).map((r) => r.data()));
    if (id !== query || !panel) return;
    if (items.length === 0) {
      message(`No results for “${term}”.`);
      return;
    }
    const list = document.createElement('ul');
    for (const item of items) {
      const li = document.createElement('li');
      const link = document.createElement('a');
      link.className = 'search-result';
      link.href = item.url;
      const title = document.createElement('span');
      title.className = 'search-result-title';
      title.textContent = item.meta.title ?? item.url;
      const excerpt = document.createElement('span');
      excerpt.className = 'search-result-excerpt';
      // Pagefind escapes the indexed text; the excerpt's only markup is its <mark> highlights.
      excerpt.innerHTML = item.excerpt;
      link.append(title, excerpt);
      li.append(link);
      list.append(li);
    }
    panel.replaceChildren(list);
    show(true);
  }

  const results = () => [...(panel?.querySelectorAll<HTMLAnchorElement>('.search-result') ?? [])];

  const openDialog = () => {
    if (!dialog || dialog.open) return;
    dialog.showModal();
    input?.select();
    void load();
  };

  document.querySelector('[data-search-open]')?.addEventListener('click', openDialog);
  document.querySelector('[data-search-close]')?.addEventListener('click', () => dialog?.close());
  // A click on the backdrop lands on the <dialog> itself; clicks inside land on the panel.
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });

  input?.addEventListener('input', () => {
    window.clearTimeout(timer);
    timer = window.setTimeout(() => void run(input.value), 120);
  });
  input?.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowDown') {
      event.preventDefault();
      results()[0]?.focus();
    }
  });
  panel?.addEventListener('keydown', (event) => {
    const links = results();
    const index = links.indexOf(document.activeElement as HTMLAnchorElement);
    if (event.key === 'ArrowDown') {
      event.preventDefault();
      links[Math.min(links.length - 1, index + 1)]?.focus();
    } else if (event.key === 'ArrowUp') {
      event.preventDefault();
      if (index <= 0) input?.focus();
      else links[index - 1]?.focus();
    }
  });
  document.addEventListener('keydown', (event) => {
    const target = event.target as HTMLElement;
    const typing = target.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName);
    if (event.key === '/' && !typing && !event.metaKey && !event.ctrlKey && !event.altKey) {
      event.preventDefault();
      openDialog();
    }
  });
</script>
