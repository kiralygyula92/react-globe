---
/** Version selector: every documented version, plus the Versions page. */
import { config, currentVersion } from '../lib/site';

const current = currentVersion();
const versionsPage = `/${config.id}/getting-started/versions/`;
---

<div class="version-select">
  <label class="sr-only" for="docs-version">Documentation version</label>
  <select id="docs-version">
    {
      (config.versions ?? []).map((v) => (
        <option value={v.href} selected={v.label === current.label}>
          {v.label}
        </option>
      ))
    }
    <option value={versionsPage}>All versions</option>
  </select>
  <svg class="chevron" viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
    <path fill="currentColor" d="M5.3 7.3a1 1 0 0 1 1.4 0L10 10.6l3.3-3.3a1 1 0 1 1 1.4 1.4l-4 4a1 1 0 0 1-1.4 0l-4-4a1 1 0 0 1 0-1.4Z"></path>
  </svg>
</div>

<script>
  const select = document.querySelector<HTMLSelectElement>('#docs-version');
  select?.addEventListener('change', () => {
    if (select.value && select.value !== window.location.pathname) window.location.href = select.value;
  });
</script>
