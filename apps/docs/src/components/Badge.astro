---
/**
 * One badge, rendered only from a nav node's plan or lifecycle (PPDS §7.1, N4).
 * `data-badge-*` lets the conformance script trace every rendered badge back to nav.json.
 */
import type { Badge } from '../lib/site';

interface Props {
  badge: Badge;
  href: string;
}

const { badge, href } = Astro.props;
const attrs = { class: 'badge', 'data-badge-kind': badge.kind, 'data-badge-value': badge.value, 'data-badge-for': href };
---

{badge.href ? <a {...attrs} href={badge.href}>{badge.label}</a> : <span {...attrs}>{badge.label}</span>}
