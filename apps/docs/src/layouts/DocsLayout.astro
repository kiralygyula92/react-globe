---
/**
 * Docs surface: announcement bar → docs header (product name, version selector,
 * search, repository link, theme switch) → sidebar · content · right rail → shared footer.
 * Metadata comes from one title and one description.
 */
import '@fontsource-variable/inter';
import '../styles/docs.css';
import Search from '../components/Search.astro';
import SidebarItems from '../components/SidebarItems.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Toc from '../components/Toc.astro';
import VersionSelect from '../components/VersionSelect.astro';
import { breadcrumbs, config, currentVersion, links, metadata, sidebar, type Page } from '../lib/site';

interface Props {
  page: Page;
  headings: { depth: number; slug: string; text: string }[];
}

const { page, headings } = Astro.props;
const meta = metadata(page, Astro.site!);
const nav = await sidebar();
const crumbs = breadcrumbs(page);
/** No announcement is configured; the slot renders only when one is (one campaign max). */
const announcement: string | null = null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Apply a stored theme before first paint, so a reader who chose one never sees a flash of the other.
      try {
        const theme = localStorage.getItem('react-globe-docs-theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {
        /* storage unavailable: follow the system preference */
      }
    </script>
    <title>{meta.documentTitle}</title>
    <link rel="canonical" href={meta.canonical} />
    {meta.meta.map((m) => ('property' in m ? <meta property={m.property} content={m.content} /> : <meta name={m.name} content={m.content} />))}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="text/markdown" href={page.twin} />
    <link rel="alternate" type="application/rss+xml" title={`${config.name} changelog`} href={`${links.changelog}rss.xml`} />
    <link rel="sitemap" href="/sitemap.xml" />
    {(config.versions ?? []).length > 1 && <meta data-pagefind-filter="version[content]" content={currentVersion().label} />}
  </head>
  <body data-pathname={page.pathname}>
    <a class="skip-link" href="#main">Skip to content</a>
    {announcement && <div class="announcement" role="region" aria-label="Announcement">{announcement}</div>}

    <header class="site-header">
      <div class="header-inner">
        <label class="icon-button nav-toggle-label" for="nav-toggle" aria-label="Open navigation">
          <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
            <path fill="currentColor" d="M3 5.75A.75.75 0 0 1 3.75 5h12.5a.75.75 0 0 1 0 1.5H3.75A.75.75 0 0 1 3 5.75Zm0 4.25a.75.75 0 0 1 .75-.75h12.5a.75.75 0 0 1 0 1.5H3.75A.75.75 0 0 1 3 10Zm.75 3.5a.75.75 0 0 0 0 1.5h12.5a.75.75 0 0 0 0-1.5H3.75Z"></path>
          </svg>
        </label>
        <a class="brand" href="/">{config.name}</a>
        <VersionSelect />
        <span class="spacer"></span>
        <Search />
        <a class="icon-button" href={config.repo} aria-label="GitHub repository">
          <svg viewBox="0 0 16 16" width="22" height="22" aria-hidden="true">
            <path
              fill="currentColor"
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
            ></path>
          </svg>
        </a>
        <ThemeToggle />
      </div>
    </header>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true" tabindex="-1" />
    <div class="docs-shell">
      <nav class="sidebar" aria-label="Documentation">
        <SidebarItems items={nav} current={page.pathname} depth={1} />
      </nav>

      <main id="main" tabindex="-1" data-pagefind-body>
        <nav class="breadcrumb" aria-label="Breadcrumb" data-pagefind-ignore>
          <ol>
            {
              crumbs.map((crumb) => (
                <li>{crumb.href ? <a href={crumb.href}>{crumb.title}</a> : <span>{crumb.title}</span>}</li>
              ))
            }
          </ol>
        </nav>
        <slot />
      </main>

      <Toc headings={headings} />
    </div>

    <SiteFooter />
  </body>
</html>
