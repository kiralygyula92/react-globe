---
/**
 * Every docs page. The route list is nav.json's pages; the archetype decides which
 * data-driven blocks surround the authored Markdown (PPDS §6).
 */
import { render } from 'astro:content';
import Badge from '../../components/Badge.astro';
import PageActions from '../../components/PageActions.astro';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { config, featureGroups, getPages, referenceHref, resourceChips, symbolPath, type Page } from '../../lib/site';

export async function getStaticPaths() {
  const pages = await getPages();
  return pages.map((page) => ({
    params: { slug: page.pathname.slice(`/${config.id}/`.length).replace(/\/$/, '') || undefined },
    props: { page },
  }));
}

interface Props {
  page: Page;
}

const { page } = Astro.props;
const { Content, headings: authored } = await render(page.entry);
const symbols = page.entry.data.symbols ?? [];
const groups = page.archetype === 'C' ? await featureGroups() : [];

const headings = [
  ...authored,
  ...(page.archetype === 'B' ? [{ depth: 2, slug: 'api', text: 'API' }] : []),
  ...groups.map((g) => ({ depth: 2, slug: g.group.toLowerCase().replace(/[^a-z0-9]+/g, '-'), text: g.group })),
];
const date = page.entry.data.date;
---

<DocsLayout page={page} headings={headings}>
  <article class="article">
    <header class="page-header">
      <h1>
        {page.heading}
        {
          page.badges.length > 0 && (
            <span class="heading-badges">
              {page.badges.map((badge) => (
                <Badge badge={badge} href={page.pathname} />
              ))}
            </span>
          )
        }
      </h1>
      {
        page.archetype === 'I' && date && (
          <time class="page-date" datetime={date.toISOString().slice(0, 10)} data-block="date">
            {date.toISOString().slice(0, 10)}
          </time>
        )
      }
      <p class="page-subtitle" data-block="subtitle">{page.description}</p>
    </header>

    {
      page.archetype === 'B' && (
        <ul class="resource-chips" data-block="resource-chips" aria-label="Resources">
          {resourceChips(page.entry).map((chip) => (
            <li>
              <a href={chip.href} data-chip={chip.key}>
                {chip.label}
              </a>
            </li>
          ))}
        </ul>
      )
    }

    {
      page.archetype === 'C' ? (
        <div data-block="scope">
          <Content />
        </div>
      ) : (
        <Content />
      )
    }

    {
      page.archetype === 'C' && (
        <div data-block="feature-groups">
          {groups.map((g) => (
            <section data-feature-group={g.group}>
              <h2 id={g.group.toLowerCase().replace(/[^a-z0-9]+/g, '-')}>{g.group}</h2>
              <ul class="feature-cards">
                {g.pages.map((p) => (
                  <li>
                    <a class="feature-card" href={p.pathname} data-feature-card={p.pathname}>
                      <span class="name">{p.title}</span>
                      {p.badges.map((badge) => (
                        <Badge badge={badge} href={p.pathname} />
                      ))}
                      <span class="one-line">{p.description}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      )
    }

    {
      page.archetype === 'B' && (
        <section class="api-links" data-block="api-links">
          <h2 id="api">API</h2>
          <ul>
            {symbols.map((symbol) => {
              const href = referenceHref(symbol);
              return (
                <li data-symbol={symbol} data-reference={symbolPath(symbol, config)}>
                  {href ? (
                    <a href={href}>
                      <code>{symbol}</code>
                    </a>
                  ) : (
                    <code>{symbol}</code>
                  )}
                </li>
              );
            })}
          </ul>
        </section>
      )
    }

    <PageActions page={page} />
  </article>
</DocsLayout>
