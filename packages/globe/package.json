{
  "name": "react-globe",
  "version": "1.0.0",
  "description": "An interactive, detailed 3D Earth for React, drawn with plain three.js.",
  "keywords": [
    "react",
    "globe",
    "earth",
    "3d",
    "three",
    "threejs",
    "webgl",
    "map",
    "geojson",
    "visualization"
  ],
  "license": "MIT",
  "author": "kiralygyula92",
  "homepage": "https://github.com/kiralygyula92/react-globe#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiralygyula92/react-globe.git",
    "directory": "packages/globe"
  },
  "bugs": {
    "url": "https://github.com/kiralygyula92/react-globe/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./globe.css": "./dist/globe.css",
    "./assets/*": "./dist/assets/*",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:js": "vite build",
    "build:css": "tailwindcss -i ./src/styles.css -o ./dist/globe.css --minify",
    "build:types": "tsc -p tsconfig.build.json",
    "build": "pnpm clean && pnpm build:js && pnpm build:css && pnpm build:types",
    "dev": "pnpm run \"/^watch:/\"",
    "watch:js": "vite build --watch",
    "watch:css": "tailwindcss -i ./src/styles.css -o ./dist/globe.css --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "three": ">=0.170"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
